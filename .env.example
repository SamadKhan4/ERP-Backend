NODE_ENV=development
HOST=0.0.0.0
PORT=5000
CLIENT_URL=http://localhost:5173,http://127.0.0.1:5173,https://adborn-erp.vercel.app
MONGO_URI=mongodb://127.0.0.1:27017/adborn_erp
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
COOKIE_SECURE=false
COOKIE_SAME_SITE=lax
TRUST_PROXY=0
ADMIN_EMAIL=
ADMIN_PASSWORD=
RESET_DELIVERY=file
SMTP_URL=
MAIL_FROM=
PASSWORD_RESET_URL=
ONBOARDING_UPLOAD_DIR=
CRM_UPLOAD_DIR=

# Document storage: use cloudinary in production; credentials are server-only.
STORAGE_DRIVER=local
UPLOAD_DIR=uploads
MAX_FILE_SIZE=10485760
UPLOAD_TOKEN_MINUTES=20
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
